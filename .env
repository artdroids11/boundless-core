# Discord Developer Portal > sua aplicação
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# ID do servidor onde os comandos serão registrados imediatamente.
# Para um bot usado apenas na Boundless, pode permanecer preenchido.
DEV_GUILD_ID=

# Banco local. Em Railway/Docker com volume, use file:/data/boundless.db
DATABASE_URL="file:./prisma/dev.db"

# Compatibilidade com comandos antigos, como b!ping
DEFAULT_PREFIX=b!

# Porta do endpoint /health usado pela hospedagem
PORT=3000
HEALTH_PORT=3000
NODE_ENV=development

# true: registra/atualiza os slash commands ao iniciar o contêiner.
# Útil na primeira implantação; pode voltar para false depois.
AUTO_DEPLOY_COMMANDS=false
